[Desktop Entry]
Type=Application
Name=Pterodactyl Fly
Comment=A flock of pterodactyls soars across the screen at altitude every now and then
Exec=python3 /home/YOU/penguin-walk/penguin-walk.py --frames frames-pterodactyl --fly 900 --speed 200 --frame-ms 90 --flock 4
Terminal=false
X-GNOME-Autostart-enabled=true
NoDisplay=true
